# Local development environment. `npm run local:setup` copies this file to
# .env.local on first run. scripts/local/run.mjs refuses to start when a value
# here could reach production services — see docs/local-development.md.

# Local SQLite file; kept between restarts and ignored by git.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

SESSION_SECRET=local-session-secret
ADMIN_PASSWORD=local-admin
CRON_SECRET=local-cron-secret
SITE_URL=http://localhost:3000

# Uploaded photos go to ./uploads (ignored by git).
UPLOADS_DIR=

# Outgoing email goes to the local mail sink started by `npm run local:dev`,
# which prints every message in the terminal. Only loopback hosts are allowed.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=local@afaolaine.test
SMTP_PASSWORD=local

# Must stay empty locally: the shared calendar feed is for the production FK site.
SHARED_CALENDAR_SECRET=

# Optional, read-only: refreshes AFA Olaine TV view counts.
YOUTUBE_API_KEY=
